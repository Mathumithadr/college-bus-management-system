# Server
NODE_ENV=development
PORT=5000

# Database
# Option 1: Local MongoDB (default for each developer)
MONGODB_URI=mongodb://localhost:27017/college_bus_management

# Option 2: Shared MongoDB Atlas (uncomment and fill in when ready)
# MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/college_bus_management

# JWT — each developer should generate their own random strings
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=replace_with_a_different_long_random_string
JWT_REFRESH_EXPIRES_IN=30d

# CORS
CLIENT_URL=http://localhost:5173

# Location freshness threshold (seconds)
LOCATION_STALE_THRESHOLD=120